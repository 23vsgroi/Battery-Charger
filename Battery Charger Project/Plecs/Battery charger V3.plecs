"elseif(n_parallel < 1)\n"
"\terror('Number of cells in parallel must be greater than 1')\n"
"elseif(n_series < 1)\n"
"\terror('Number of cells in series must be greater than 1')\t\n"
"end\n"
"\n"
"T_delay = 1e-9;"
