      Parameter {
        Variable      "Declarations"
        Value         "double Ts;\n"
"double Ki;\n"
"double Kp;\n"
"double error;\n"
"double duty;"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "Ts = 20e-6;\n"
"Ki = 50;\n"
"Kp = 0.1;\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* Calculate error */\n"
"error = InputSignal(0,0) - InputSignal(1,0);\n"
"\n"
"/* Calculate PI output */\n"
"duty = Kp * error + DiscState(0);\n"
"\n"
"/* Limit duty cycle */\n"
"if (duty > 1.0)\n"
"{\n"
"    duty = 1.0;\n"
"}\n"
"\n"
"if (duty < 0.0)\n"
"{\n"
"    duty = 0.0;\n"
"}\n"
"\n"
"\n"
"OutputSignal(0,0)=duty;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "error = InputSignal(0, 0) - InputSignal(1, 0);\n"
"\n"
"DiscState(0) += Ki * error * 20e-6;"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
