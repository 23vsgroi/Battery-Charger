  InitializationCommands "%% Battery Parameters\nn_series = 8; % Number of ser"
"ies connected cells\nn_parallel = 1; % Number of parallel branches\nSOC_init "
"= 0; % initial SOC\n\ncell_cap = 8; % Cell capacitance\npack_cap = cell_cap *"
" n_parallel; % Pack capacitance\n\n%cell_ConstI = 1.3; % Target constant char"
"ging current for each cell\n%cell_ConstV = 4.1; % Target constant charging vo"
"ltage for each cell\n\n%ConstI = cell_ConstI * n_parallel; % Target constant "
"charging current\n%ConstV = cell_ConstV * n_series; % Target constant chargin"
"g voltage\n\nMAX_SOC = 1; % State of charge when battery charging is stopped"
