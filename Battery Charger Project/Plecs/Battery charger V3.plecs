      MaskIconOpaque off
      MaskIconRotates on
      MaskInit      "cell_cap = pack_cap / n_parallel;\n"
"\n"
"if (R_contact <= 0) \n"
"\terror('Ideal metallic contact. Please change resistance to nonzero value')"
