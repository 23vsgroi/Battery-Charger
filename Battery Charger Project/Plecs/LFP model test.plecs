Plecs {
  Name          "LFP model test"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "1500.0"
  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "10"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "%% Battery Parameters\nn_series = 8; % Number of ser"
"ies connected cells\nn_parallel = 1; % Number of parallel branches\nSOC_init "
"= 0; % initial SOC\n\ncell_cap = 8; % Cell capacitance\npack_cap = cell_cap *"
" n_parallel; % Pack capacitance\n\nMAX_SOC = 1; % State of charge when batter"
"y charging is stopped"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
  ExtendedMatrixPrecision "1"
  MatrixSignificanceCheck "2"
  RemoveUnusedStateSpaceOutputs "2"
  EnableStateSpaceSplitting "2"
  DisplayStateSpaceSplitting "1"
  DiscretizationMethod "2"
  ExternalModeSettings ""
  AlgebraicLoopMethod "1"
  AlgebraicLoopTolerance "1e-6"
  ScriptsDialogGeometry "[700 385 500 244]"
  ScriptsDialogSplitterPos "100"
  MixedSignalSolverBypassOperatingPoint "1"
  MixedSignalSolverInitialConditions "2"
  MixedSignalSolverMaxNewtonIterations "25"
  MixedSignalSolverNumThreads "-1"
  OperatingPointMaxNewtonIterations "50"
  OperatingPointRelativeNewtonTolerance "1e-3"
  OperatingPointAbsoluteNewtonTolerance "1e-12"
  OperatingPointNodalVoltageNewtonTolerance "1e-6"
  SpiceTemperature "27"
  SpiceGMin     "0"
  SpiceInductorRPar "0"
  SpiceInductorRSer "0"
  SpiceCapacitorGPar "0"
  SpiceCapacitorRSer "0"
  NetlistParserDetails "2"
  InvalidNetlistFunctionEvaluationMsg "1"
  IncompatibleInitialConditionMsg "2"
  Schematic {
    Location      [0, 23; 1536, 773]
    ZoomFactor    0.999994
    SliderPosition [83, 0]
    ShowBrowser   off
    BrowserWidth  100
    Component {
      Type          Subsystem
      Name          "Li-ion\nRC Model2"
      Show          on
      Position      [320, 250]
      Direction     up
      Flipped       off
      LabelPosition west
      Frame         [-10, -20; 10, 20]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Lithium ion Battery RC model"
      MaskDescription "Resistor-Capacitor based model of a Li-ion battery base"
"d on \"Accurate Electrical Battery Model Capable of Predicting Runtime and I-"
"V Performance\" by Chen, M.; Ricon-Mora, G. A."
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      MaskInit      "cell_cap = pack_cap / n_parallel;\n"
"\n"
"if (R_contact <= 0) \n"
"\terror('Ideal metallic contact. Please change resistance to nonzero value')"
"\n"
"elseif(n_parallel < 1)\n"
"\terror('Number of cells in parallel must be greater than 1')\n"
"elseif(n_series < 1)\n"
"\terror('Number of cells in series must be greater than 1')\t\n"
"end\n"
"\n"
"T_delay = 1e-9;"
      Parameter {
        Variable      "pack_cap"
        Prompt        "Battery Pack Capacity"
        Type          FreeText
        Value         "pack_cap"
        Show          off
        Tunable       off
        TabName       ""
      }
      Parameter {
        Variable      "soc_init"
        Prompt        "Initial SOC"
        Type          FreeText
        Value         "SOC_init"
        Show          off
        Tunable       off
        TabName       ""
      }
      Parameter {
